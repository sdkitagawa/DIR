<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Background -->
    <SolidColorBrush x:Key="WindowBackground" Color="#171717"/>

    <!-- Titlebar -->
    <LinearGradientBrush x:Key="TitlebarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#505050" Offset="0"/>
        <GradientStop Color="#292929" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TitlebarBorder" Color="#111111"/>

    <!-- Cards -->
    <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#404040" Offset="0"/>
        <GradientStop Color="#303030" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBorder" Color="#151515"/>
    <SolidColorBrush x:Key="RowDivider" Color="#202020"/>

    <!-- Directory Row Icons -->
    <SolidColorBrush x:Key="IconBackground" Color="#292929"/>
    <SolidColorBrush x:Key="IconBorder" Color="#151515"/>
    <SolidColorBrush x:Key="FolderIconColor" Color="#67B5FF"/>
    <SolidColorBrush x:Key="TagIconColor" Color="#A87CFF"/>
    <SolidColorBrush x:Key="PtbIconColor" Color="#61E5EB"/>
    <SolidColorBrush x:Key="CanaryIconColor" Color="#FFAD42"/>

    <!-- Inputs -->
    <LinearGradientBrush x:Key="InputBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#181818" Offset="0"/>
        <GradientStop Color="#242424" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="InputBorder" Color="#111111"/>
    <SolidColorBrush x:Key="InputBorderFocus" Color="#4E8CFF"/>
    <CornerRadius x:Key="InputCornerRadius">5</CornerRadius>

    <!-- Browse Button -->
    <LinearGradientBrush x:Key="BrowseButtonBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#626262" Offset="0"/>
        <GradientStop Color="#3A3A3A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrowseButtonGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#626262" Offset="0"/>
        <GradientStop Color="#3A3A3A" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BrowseButtonHover" Color="#707070"/>
    <SolidColorBrush x:Key="BrowseButtonBorder" Color="#171717"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4E8CFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3A7AE8"/>

    <!-- Checkbox -->
    <SolidColorBrush x:Key="CheckboxChecked" Color="#2877D8"/>
    <SolidColorBrush x:Key="CheckboxUnchecked" Color="#252525"/>
    <SolidColorBrush x:Key="CheckboxBorder" Color="#154D91"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#B7B7B7"/>
    <SolidColorBrush x:Key="TextMuted" Color="#888888"/>

    <!-- Buttons -->
    <LinearGradientBrush x:Key="PrimaryButtonBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#438BE8" Offset="0"/>
        <GradientStop Color="#1761C6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryButtonHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#5598EE" Offset="0"/>
        <GradientStop Color="#2370D7" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PrimaryButtonBorder" Color="#0B418E"/>
    <LinearGradientBrush x:Key="SecondaryButtonBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#626262" Offset="0"/>
        <GradientStop Color="#3A3A3A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SecondaryButtonHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#707070" Offset="0"/>
        <GradientStop Color="#454545" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SecondaryButtonBorder" Color="#171717"/>

    <!-- Toast -->
    <SolidColorBrush x:Key="ToastBackground" Color="#161616DD"/>
    <SolidColorBrush x:Key="ToastBorder" Color="#555555"/>

    <!-- Window Traffic Lights -->
    <SolidColorBrush x:Key="TrafficLightRed" Color="#E34B45"/>
    <SolidColorBrush x:Key="TrafficLightYellow" Color="#E4B93D"/>
    <SolidColorBrush x:Key="TrafficLightGreen" Color="#43C45B"/>

    <!-- Window Controls -->
    <SolidColorBrush x:Key="WindowControlForeground" Color="#DDDDDD"/>
    <SolidColorBrush x:Key="WindowControlHover" Color="#6A6A6A"/>
    <SolidColorBrush x:Key="WindowControlPressed" Color="#585858"/>
    <SolidColorBrush x:Key="WindowCloseHover" Color="#ED4245"/>
    <SolidColorBrush x:Key="WindowClosePressed" Color="#C9303A"/>

    <!-- Skin Selector -->
    <SolidColorBrush x:Key="SkinSelectorBackground" Color="#292929"/>
    <SolidColorBrush x:Key="SkinSelectorBorder" Color="#151515"/>

    <!-- Font -->
    <FontFamily x:Key="AppFont">Candara</FontFamily>

</ResourceDictionary>
