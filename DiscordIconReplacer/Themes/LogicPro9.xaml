<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Background -->
    <SolidColorBrush x:Key="WindowBackground" Color="#222222"/>

    <!-- Titlebar -->
    <LinearGradientBrush x:Key="TitlebarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#AAAAAA" Offset="0"/>
        <GradientStop Color="#666666" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TitlebarBorder" Color="#333333"/>

    <!-- Cards -->
    <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#555555" Offset="0"/>
        <GradientStop Color="#444444" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBorder" Color="#222222"/>
    <SolidColorBrush x:Key="RowDivider" Color="#292929"/>

    <!-- Directory Row Icons -->
    <LinearGradientBrush x:Key="IconGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#444444" Offset="0"/>
        <GradientStop Color="#191919" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="IconBackground" Color="#333333"/>
    <SolidColorBrush x:Key="IconBorder" Color="#171717"/>
    <SolidColorBrush x:Key="FolderIconColor" Color="#6EBCFF"/>
    <SolidColorBrush x:Key="TagIconColor" Color="#AE7CFF"/>
    <SolidColorBrush x:Key="PtbIconColor" Color="#64E9ED"/>
    <SolidColorBrush x:Key="CanaryIconColor" Color="#FFAE43"/>

    <!-- Inputs -->
    <LinearGradientBrush x:Key="InputBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#181818" Offset="0"/>
        <GradientStop Color="#292929" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="InputBorder" Color="#222222"/>
    <SolidColorBrush x:Key="InputBorderFocus" Color="#5799DF"/>
    <CornerRadius x:Key="InputCornerRadius">4</CornerRadius>

    <!-- Browse Button -->
    <LinearGradientBrush x:Key="BrowseButtonBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#888888" Offset="0"/>
        <GradientStop Color="#555555" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrowseButtonGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#888888" Offset="0"/>
        <GradientStop Color="#555555" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BrowseButtonHover" Color="#999999"/>
    <SolidColorBrush x:Key="BrowseButtonBorder" Color="#202020"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#3D8BE5"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2D6BA8"/>

    <!-- Checkbox -->
    <LinearGradientBrush x:Key="CheckboxGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3D8BE5" Offset="0"/>
        <GradientStop Color="#1658A8" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CheckboxChecked" Color="#3D8BE5"/>
    <SolidColorBrush x:Key="CheckboxUnchecked" Color="#333333"/>
    <SolidColorBrush x:Key="CheckboxBorder" Color="#222222"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#DDDDDD"/>
    <SolidColorBrush x:Key="TextMuted" Color="#AAAAAA"/>

    <!-- Buttons -->
    <LinearGradientBrush x:Key="PrimaryButtonBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#6BA3E7" Offset="0"/>
        <GradientStop Color="#2D66A8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryButtonHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#7FB2EC" Offset="0"/>
        <GradientStop Color="#3A72B0" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PrimaryButtonBorder" Color="#183E69"/>
    <LinearGradientBrush x:Key="SecondaryButtonBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#888888" Offset="0"/>
        <GradientStop Color="#555555" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SecondaryButtonHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#999999" Offset="0"/>
        <GradientStop Color="#666666" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SecondaryButtonBorder" Color="#202020"/>

    <!-- Toast -->
    <SolidColorBrush x:Key="ToastBackground" Color="#222222EE"/>
    <SolidColorBrush x:Key="ToastBorder" Color="#777777"/>

    <!-- Window Traffic Lights -->
    <RadialGradientBrush x:Key="TrafficLightRed" GradientOrigin="0.35,0.3">
        <GradientStop Color="#FF827C" Offset="0"/>
        <GradientStop Color="#A40000" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="TrafficLightYellow" GradientOrigin="0.35,0.3">
        <GradientStop Color="#FFE778" Offset="0"/>
        <GradientStop Color="#9A6900" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="TrafficLightGreen" GradientOrigin="0.35,0.3">
        <GradientStop Color="#8CFF8C" Offset="0"/>
        <GradientStop Color="#087D17" Offset="1"/>
    </RadialGradientBrush>

    <!-- Window Controls -->
    <SolidColorBrush x:Key="WindowControlForeground" Color="#111111"/>
    <SolidColorBrush x:Key="WindowControlHover" Color="#8E8E8E"/>
    <SolidColorBrush x:Key="WindowControlPressed" Color="#7A7A7A"/>
    <SolidColorBrush x:Key="WindowCloseHover" Color="#ED4245"/>
    <SolidColorBrush x:Key="WindowClosePressed" Color="#C9303A"/>

    <!-- Skin Selector -->
    <SolidColorBrush x:Key="SkinSelectorBackground" Color="#444444"/>
    <SolidColorBrush x:Key="SkinSelectorBorder" Color="#222222"/>

    <!-- Font -->
    <FontFamily x:Key="AppFont">Lucida Sans</FontFamily>

</ResourceDictionary>
