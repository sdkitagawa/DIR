<UserControl x:Class="DiscordIconReplacer.Controls.DirectoryRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             MinHeight="82"
             SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="57"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="96"/>
            </Grid.ColumnDefinitions>

            <!-- Icon badge -->
            <Border Grid.Column="0" Width="43" Height="43" CornerRadius="8"
                    Background="{DynamicResource IconBackground}"
                    BorderBrush="{DynamicResource IconBorder}"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                <Grid>
                    <TextBlock x:Name="IconTextBlock"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="Bold"/>
                    <Image x:Name="IconImage" Width="28" Height="28" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"
                           SnapsToDevicePixels="True"/>
                    <Path x:Name="IconFolderPath" Width="26" Height="26" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="Collapsed"
                          Fill="{DynamicResource FolderIconColor}"
                          Data="M2,6 C2,4.9 2.9,4 4,4 L8,4 L10,6 L20,6 C21.1,6 22,6.9 22,8 L22,18 C22,19.1 21.1,20 20,20 L4,20 C2.9,20 2,19.1 2,18 Z"/>
                </Grid>
            </Border>

            <!-- Label + description -->
            <StackPanel Grid.Column="1" Width="300" VerticalAlignment="Center" Margin="14,0,10,0">
                <TextBlock x:Name="TitleTextBlock"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DescriptionTextBlock" Margin="0,5,0,0"
                           FontSize="12" Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           MaxHeight="32"/>
            </StackPanel>

<!-- Path input -->
            <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                <Border CornerRadius="{DynamicResource InputCornerRadius}"
                        Background="{DynamicResource InputBackground}"
                        BorderBrush="{DynamicResource InputBorder}"
                        BorderThickness="1">
                    <Grid>
                        <TextBox x:Name="PathTextBox"
                                 Height="42" VerticalContentAlignment="Center"
                                 Padding="12,0" FontSize="13"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimary}"
                                 CaretBrush="{DynamicResource TextPrimary}"
                                 TextChanged="PathTextBox_TextChanged"/>
                        <TextBlock x:Name="PlaceholderText"
                                   Margin="13,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontSize="13" Text="Not set"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Browse button -->
            <Button x:Name="BrowseButton" Grid.Column="3"
                    Content="Browse…"
                    Height="42" Width="96"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    FontWeight="Bold" FontSize="13"
                    Style="{StaticResource FooterPrimaryButtonStyle}"/>
        </Grid>

        <!-- Row divider -->
        <Border x:Name="DividerBorder" Grid.Row="1" Height="1"
                Background="{DynamicResource RowDivider}"
                Visibility="{Binding DividerVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    </Grid>
</UserControl>